        startupControls.append(startupRotateRow);

        const startupMirrorRow = new Gtk.Box({orientation: Gtk.Orientation.HORIZONTAL, spacing: 8});
        this.startupMirrorHorizontalButton = this.makeToolButton('↔ Left / Right', 'Mirror startup content left and right', () => {
            if (this.loadingConfig)
                return;
            this.startupMirrorHorizontalValue = this.startupMirrorHorizontalButton.get_active();
            this.refreshStartupPreview();
        }, true);
        startupMirrorRow.append(this.startupMirrorHorizontalButton);
        this.startupMirrorVerticalButton = this.makeToolButton('↕ Top / Bottom', 'Mirror startup content top and bottom', () => {
            if (this.loadingConfig)
                return;
            this.startupMirrorVerticalValue = this.startupMirrorVerticalButton.get_active();
            this.refreshStartupPreview();
