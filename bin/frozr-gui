        startupMirrorRow.append(this.startupMirrorVerticalButton);
        startupControls.append(startupMirrorRow);

        const startupResetRow = new Gtk.Box({orientation: Gtk.Orientation.HORIZONTAL, spacing: 8});
        const startupResetButton = this.makeButton('Reset orientation', () => this.resetStartupTransform());
        startupResetButton.add_css_class('flat');
        startupResetRow.append(startupResetButton);
        startupControls.append(startupResetRow);

        const startupActions = new Gtk.Box({orientation: Gtk.Orientation.HORIZONTAL, spacing: 8});
        this.startupUseButton = this.makeButton('Set startup content', () => this.setSelectedAsStartupDisplay());
        this.startupUseButton.set_sensitive(false);
        this.startupUseButton.add_css_class('suggested-action');
        this.startupUseButton.set_hexpand(true);
        startupActions.append(this.startupUseButton);
        startupActions.append(this.makeButton('Use device default', () => this.resetStartupDisplay()));
        startupControls.append(startupActions);

        phases.append(new Gtk.Separator({orientation: Gtk.Orientation.HORIZONTAL}));
        const sessionBody = new Gtk.Box({
            orientation: Gtk.Orientation.VERTICAL,
