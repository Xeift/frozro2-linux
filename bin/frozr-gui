        const startupPreviewClick = new Gtk.GestureClick();
        startupPreviewClick.connect('released', () => this.chooseStartupFile());
        startupOverlay.add_controller(startupPreviewClick);
        startupPreviewColumn.append(startupOverlay);
        startupEditor.append(startupPreviewColumn);

        const startupControls = new Gtk.Box({orientation: Gtk.Orientation.VERTICAL, spacing: 14, hexpand: true});
        startupControls.set_valign(Gtk.Align.START);
        startupEditor.append(startupControls);

        const startupChooseButton = this.makeButton('Choose content…', () => this.chooseStartupFile());
        startupChooseButton.add_css_class('pill');
        startupControls.append(startupChooseButton);
        this.startupFileLabel = new Gtk.Label({label: 'Nothing selected', xalign: 0, ellipsize: 3, wrap: true});
        this.startupFileLabel.add_css_class('dim-label');
        startupControls.append(this.startupFileLabel);

        const startupOrientationHeader = new Gtk.Box({orientation: Gtk.Orientation.HORIZONTAL, spacing: 8});
        const startupOrientationTitle = new Gtk.Label({label: 'Orientation', xalign: 0, hexpand: true});
        startupOrientationTitle.add_css_class('heading');
