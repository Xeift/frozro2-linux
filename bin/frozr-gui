#!/usr/bin/gjs
'use strict';

imports.gi.versions.Gtk = '4.0';
imports.gi.versions.Gdk = '4.0';
imports.gi.versions.Adw = '1';

const Gio = imports.gi.Gio;
const GLib = imports.gi.GLib;
const Gtk = imports.gi.Gtk;
const Gdk = imports.gi.Gdk;
const Adw = imports.gi.Adw;
const Cairo = imports.cairo;
const System = imports.system;

const ROOTS = [
    '/mnt/SDCARD/video/',
    '/mnt/SDCARD/img/',
    '/root/video/',
    '/root/img/',
];

function pathExists(path) {
    return GLib.file_test(path, GLib.FileTest.EXISTS);
}

function drawRoundMask(_area, cr, width, height) {
    const size = Math.min(width, height);
    const cx = width / 2;
    const cy = height / 2;
    const radius = Math.max(1, size / 2 - 5);

    cr.setFillRule(Cairo.FillRule.EVEN_ODD);
    cr.rectangle(0, 0, width, height);
    cr.arc(cx, cy, radius, 0, Math.PI * 2);
    cr.setSourceRGBA(0.025, 0.025, 0.03, 1);
    cr.fill();

    cr.setFillRule(Cairo.FillRule.WINDING);
    cr.arc(cx, cy, radius, 0, Math.PI * 2);
    cr.setLineWidth(7);
    cr.setSourceRGBA(0.12, 0.13, 0.15, 1);
    cr.stroke();
    cr.arc(cx, cy, radius - 4, 0, Math.PI * 2);
    cr.setLineWidth(1.5);
    cr.setSourceRGBA(0.42, 0.45, 0.48, 0.8);
    cr.stroke();
}

function resolveCli() {
    const invoked = System.programInvocationName;
    const absolute = GLib.path_is_absolute(invoked)
        ? invoked
        : GLib.canonicalize_filename(invoked, GLib.get_current_dir());
    const sibling = GLib.build_filenamev([GLib.path_get_dirname(absolute), 'frozrctl']);
    if (pathExists(sibling))
        return sibling;
    const fromPath = GLib.find_program_in_path('frozrctl');
    if (fromPath)
        return fromPath;
    throw new Error('frozrctl was not found next to the GUI or in PATH');
}

if (ARGV.includes('--help')) {
    print('Usage: frozr-gui\n\nGTK4/Libadwaita frontend for frozrctl.');
    System.exit(0);
}

let gtkReady = false;
try {
    gtkReady = Gtk.init_check();
} catch (error) {
    printerr(`frozr-gui: GTK initialization failed: ${error.message}`);
    System.exit(1);
}
if (!gtkReady) {
    printerr('frozr-gui: unable to open the graphical display. Run it from your logged-in desktop session (without sudo).');
    System.exit(1);
}

const CLI = resolveCli();

class FrozrWindow {
    constructor(app) {
        this.app = app;
        this.window = new Adw.ApplicationWindow({
            application: app,
            title: 'Frozr-O II Linux',
            default_width: 960,
            default_height: 840,
        });
        this.busy = 0;
        this.selectedFile = null;
        this.selectedKind = null;
        this.selectedCodec = null;
        this.contentInfoProc = null;
        this.startupSelectedFile = null;
        this.startupSelectedKind = null;
        this.startupSelectedCodec = null;
        this.startupContentInfoProc = null;
        this.startupPreviewProc = null;
        this.startupFrameProc = null;
        this.startupFrameTimerId = 0;
        this.startupFrameDir = null;
        this.startupPreviewFrames = [];
        this.startupActivePreviewPath = null;
        this.startupPreviewGeneration = 0;
        this.lastAction = null;
        this.resumeDashboardAfterStartup = false;
        this.dashboardProc = null;
        this.previewProc = null;
        this.previewFrameProc = null;
        this.previewFrameTimerId = 0;
        this.previewFrameDir = null;
        this.previewFrames = [];
        this.activePreviewPath = null;
        this.previewGeneration = 0;
        this.previewTempPaths = new Set();
        this.transformSaveProc = null;
        this.pendingTransformSave = null;
        this.rotation = 0;
        this.mirrorHorizontalValue = false;
        this.mirrorVerticalValue = false;
        this.startupRotation = 0;
        this.startupMirrorHorizontalValue = false;
        this.startupMirrorVerticalValue = false;
        this.buildUi();
        this.refreshStatus(true);
        this.loadConfig();
    }

    buildUi() {
        const root = new Gtk.Box({orientation: Gtk.Orientation.VERTICAL});
        const header = new Adw.HeaderBar();
        header.set_title_widget(new Adw.WindowTitle({title: 'Frozr-O II Linux', subtitle: 'XIGMATEK Frozr-O II LCD controller'}));
        root.append(header);

        const scroller = new Gtk.ScrolledWindow({hexpand: true, vexpand: true});
        const content = new Gtk.Box({
            orientation: Gtk.Orientation.VERTICAL,
            spacing: 18,
            margin_top: 18,
            margin_bottom: 18,
            margin_start: 18,
            margin_end: 18,
        });
        scroller.set_child(content);
        root.append(scroller);

        content.append(this.buildDeviceSection());
        content.append(this.buildDisplaySection());
        content.append(this.buildStorageSection());
        content.append(this.buildLogSection());

        this.window.set_content(root);
    }

    makeSection(title) {
        const outer = new Gtk.Box({orientation: Gtk.Orientation.VERTICAL, spacing: 8});
        const label = new Gtk.Label({label: title, xalign: 0});
        label.add_css_class('title-4');
        outer.append(label);
        const frame = new Gtk.Frame();
        const body = new Gtk.Box({
            orientation: Gtk.Orientation.VERTICAL,
            spacing: 10,
            margin_top: 12,
            margin_bottom: 12,
            margin_start: 12,
            margin_end: 12,
        });
        frame.set_child(body);
        outer.append(frame);
        return {outer, body};
    }

    makeButton(label, callback) {
        const button = new Gtk.Button({label});
        button.connect('clicked', callback);
        return button;
    }

    makeToolButton(label, tooltip, callback, toggle = false) {
        const button = toggle ? new Gtk.ToggleButton({label}) : new Gtk.Button({label});
        button.set_tooltip_text(tooltip);
        button.add_css_class('pill');
        if (toggle)
            button.connect('toggled', callback);
        else
            button.connect('clicked', callback);
        return button;
    }

    buildDeviceSection() {
        const {outer, body} = this.makeSection('Device');
        const row = new Gtk.Box({orientation: Gtk.Orientation.HORIZONTAL, spacing: 8});
        this.statusLabel = new Gtk.Label({label: 'Checking…', xalign: 0, hexpand: true, wrap: true});
        row.append(this.statusLabel);
        row.append(this.makeButton('Refresh', () => this.refreshStatus()));
        body.append(row);
        return outer;
    }

    buildDisplaySection() {
        const outer = new Gtk.Box({orientation: Gtk.Orientation.VERTICAL, spacing: 10});
        const displayTitle = new Gtk.Label({label: 'Display', xalign: 0});
        displayTitle.add_css_class('title-4');
        outer.append(displayTitle);
        const body = new Gtk.Box({orientation: Gtk.Orientation.VERTICAL, spacing: 12});
        outer.append(body);

        const brightnessTitle = new Gtk.Label({label: 'Brightness', xalign: 0});
        brightnessTitle.add_css_class('heading');
        body.append(brightnessTitle);

        const brightnessRow = new Gtk.Box({orientation: Gtk.Orientation.HORIZONTAL, spacing: 10});
        this.brightness = new Gtk.Scale({
            orientation: Gtk.Orientation.HORIZONTAL,
            adjustment: new Gtk.Adjustment({lower: 0, upper: 100, step_increment: 1, page_increment: 10, value: 25}),
