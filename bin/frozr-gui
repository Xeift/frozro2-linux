        const startupEmptyIcon = new Gtk.Image({icon_name: 'image-x-generic-symbolic', pixel_size: 64});
        startupEmptyIcon.add_css_class('dim-label');
        startupEmptyPreview.append(startupEmptyIcon);
        const startupEmptyTitle = new Gtk.Label({label: 'Choose content'});
        startupEmptyTitle.add_css_class('title-4');
        startupEmptyPreview.append(startupEmptyTitle);
        this.startupPreviewPicture = new Gtk.Picture({
            content_fit: Gtk.ContentFit.CONTAIN,
            can_shrink: true,
            keep_aspect_ratio: true,
            can_target: false,
        });
        this.startupPreviewStack.add_named(startupEmptyPreview, 'empty');
        this.startupPreviewStack.add_named(this.startupPreviewPicture, 'picture');
        this.startupPreviewStack.set_visible_child_name('empty');
        startupOverlay.set_child(this.startupPreviewStack);
        this.startupPreviewMask = new Gtk.DrawingArea({hexpand: true, vexpand: true, can_target: false});
        this.startupPreviewMask.set_draw_func(drawRoundMask);
        startupOverlay.add_overlay(this.startupPreviewMask);
        this.startupPreviewSpinner = new Gtk.Spinner({
            halign: Gtk.Align.CENTER,
