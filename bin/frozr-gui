        brightnessRow.append(brightnessApply);
        body.append(brightnessRow);
        body.append(new Gtk.Separator({orientation: Gtk.Orientation.HORIZONTAL}));

        const phases = new Gtk.Box({orientation: Gtk.Orientation.VERTICAL, spacing: 14});
        body.append(phases);

        const startupBody = new Gtk.Box({
            orientation: Gtk.Orientation.VERTICAL,
            spacing: 10,
